NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/p2p_offgrid?replicaSet=rs0&directConnection=true
MONGODB_DB=p2p_offgrid
MONGODB_REPLICA_SET=rs0
SESSION_TTL_SECONDS=604800
# Optional: configure all three settings to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional one-use installation setup token (at least 32 random characters).
ADMIN_SETUP_TOKEN=
# Approved public RPC root hosts for EVM ownership proofs. Local RPC is separately guarded.
EVM_RPC_ALLOWED_HOSTS=sepolia.drpc.org,ethereum-sepolia-rpc.publicnode.com
