{
  "name": "p2p-offgrid",
  "version": "0.1.0",
  "private": true,
  "description": "Secure simulated peer-to-peer asset transfers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "scripts": {
    "dev": "npm run build -w @p2p/contracts && concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @p2p/api",
    "dev:web": "npm run dev -w @p2p/web",
    "build": "npm run build -w @p2p/contracts && npm run build -w @p2p/api && npm run build -w @p2p/web",
    "typecheck": "npm run build -w @p2p/contracts && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run build && npm run format:check",
    "db:init": "node scripts/db-init.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "smoke": "node scripts/smoke.mjs",
    "infra:up": "docker compose up -d --wait && npm run db:init",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "mongodb": "7.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
